# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Secret & Expiry
JWT_SECRET=evalhub_jwt_secret_key_2026min314_secure
JWT_EXPIRES_IN=24h

# Database Configuration (MySQL Primary)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=evalhub_db

# Auto-fallback to local SQLite if MySQL server is unreachable (true/false)
DB_AUTO_FALLBACK=true

# Code Execution Engine Limits
EXECUTION_TIMEOUT_MS=5000
MAX_OUTPUT_CHARS=10000
MAX_FILE_SIZE_MB=5
